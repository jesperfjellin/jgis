# Copy to environments/.env and fill in the passwords.
# `make env` does this and generates random passwords.
POSTGRES_PASSWORD=
GEOSERVER_DB_PASSWORD=
GEOSERVER_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Host ports (bound to 127.0.0.1 only).
POSTGIS_PORT=5440
GEOSERVER_PORT=8085
GEOLIBRE_PORT=8086
GRAFANA_PORT=8087
PROMETHEUS_PORT=8088
LOKI_PORT=8089

# Memory. Each service has a hard limit, so the whole stack stays within a
# known budget (about 5.5 GB with these values). The JVM heap and the PostgreSQL
# caches must fit inside their container's limit.
GEOSERVER_MEM_LIMIT=2560m
GEOSERVER_JAVA_OPTS="-Xms512m -Xmx1536m"
POSTGIS_MEM_LIMIT=1536m
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1GB
GRAFANA_MEM_LIMIT=512m
PROMETHEUS_MEM_LIMIT=256m
LOKI_MEM_LIMIT=256m
ALLOY_MEM_LIMIT=256m
POSTGRES_EXPORTER_MEM_LIMIT=64m
GEOLIBRE_MEM_LIMIT=128m
# One-off jobs: the OSM import, Terraform, k6 and the load test report.
LOADER_MEM_LIMIT=3g
BOOTSTRAP_MEM_LIMIT=256m
K6_MEM_LIMIT=512m
REPORT_MEM_LIMIT=256m

# Optional overrides.
# GEOSERVER_VERSION=3.0.1
# OSM_EXTRACT_URL=https://download.geofabrik.de/europe/norway-latest.osm.pbf
# OSM2PGSQL_CACHE_MB=1500
# OSM2PGSQL_PROCESSES=4
# PROMETHEUS_RETENTION=15d
# Database and role GeoServer uses, for the load test report's PostgreSQL sections.
# LOADTEST_DB_NAME=gis
# LOADTEST_DB_ROLE=geoserver
