{
  "uid": "jgis-loadtest",
  "title": "Load test",
  "description": "k6 results for one test run, next to GeoServer, JVM and database metrics for the same time window.",
  "tags": [
    "jgis"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "testid"
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "sort": 2,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "GeoServer requests",
      "type": "link",
      "url": "/d/jgis-geoserver-requests",
      "keepTime": true
    },
    {
      "title": "GeoServer JVM",
      "type": "link",
      "url": "/d/jgis-geoserver-jvm",
      "keepTime": true
    },
    {
      "title": "PostGIS",
      "type": "link",
      "url": "/d/jgis-postgis",
      "keepTime": true
    },
    {
      "title": "Load test",
      "type": "link",
      "url": "/d/jgis-loadtest",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Virtual users (max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "max(max_over_time(k6_vus{testid=\"$testid\"}[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Requests / s (peak, 1 min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
