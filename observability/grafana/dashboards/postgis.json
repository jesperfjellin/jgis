    {
      "type": "row",
      "title": "Queries (pg_stat_statements)",
      "collapsed": false,
      "panels": [],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Top queries by total time (GeoServer role)",
      "description": "For the selected time range. Time share is seconds of query time per second of wall time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mean time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "calls / s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "query"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 900
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "time share",
              "Value #B": "mean time",
              "Value #C": "calls / s"
            },
            "indexByName": {
              "query": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "queryid": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "time share",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "time share",
                "config": {
                  "id": "isNull"
                }
              }
            ],
            "type": "exclude",
            "match": "any"
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(15, sum by (queryid) (rate(pg_stat_statements_seconds_total{datname=\"gis\",user=\"geoserver\"}[$__range]))) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)",
          "instant": true,
          "format": "table",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (queryid) (rate(pg_stat_statements_seconds_total{datname=\"gis\",user=\"geoserver\"}[$__range])) / sum by (queryid) (rate(pg_stat_statements_calls_total{datname=\"gis\",user=\"geoserver\"}[$__range])) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "sum by (queryid) (rate(pg_stat_statements_calls_total{datname=\"gis\",user=\"geoserver\"}[$__range])) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id)",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Query time share by query (top 10)",
      "description": "Seconds of query time per second, per statement. Match the queryid with the table above.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (queryid) (rate(pg_stat_statements_seconds_total{datname=\"gis\",user=\"geoserver\"}[$__rate_interval])))",
          "legendFormat": "{{queryid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "panels": [],
