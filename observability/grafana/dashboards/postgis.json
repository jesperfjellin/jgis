{
  "uid": "jgis-postgis",
  "title": "PostGIS",
  "description": "Database activity and query statistics, from postgres_exporter and pg_stat_statements.",
  "tags": [
    "jgis"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "GeoServer requests",
      "type": "link",
