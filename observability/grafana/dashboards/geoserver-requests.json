{
  "uid": "jgis-geoserver-requests",
  "title": "GeoServer requests",
  "description": "Request rate, latency percentiles and tile cache efficiency, from GeoServer's access log.",
  "tags": [
    "jgis"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(geoserver_request_duration_seconds_count, service)",
          "refId": "service"
        },
        "definition": "label_values(geoserver_request_duration_seconds_count, service)",
        "regex": "/^(?!web$|rest$|other$).*/",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "GeoServer requests",
      "type": "link",
      "url": "/d/jgis-geoserver-requests",
      "keepTime": true
    },
    {
      "title": "GeoServer JVM",
      "type": "link",
      "url": "/d/jgis-geoserver-jvm",
      "keepTime": true
    },
    {
      "title": "PostGIS",
      "type": "link",
      "url": "/d/jgis-postgis",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(geoserver_request_duration_seconds_count{service=~\"$service\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "P95 latency",
      "description": "Over all selected services, including cache hits.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(geoserver_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Tile cache hit ratio",
