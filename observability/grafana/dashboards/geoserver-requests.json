      },
      "targets": [
        {
          "expr": "sum(rate(geoserver_request_duration_seconds_count{service=~\"$service\",cache=\"hit\"}[$__rate_interval])) / sum(rate(geoserver_request_duration_seconds_count{service=~\"$service\",cache=~\"hit|miss\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false
